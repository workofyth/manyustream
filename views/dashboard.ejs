// Placeholder functions - implement based on your existing modal/API logic

async function startStream(id) {
  if (!id) return;
  try {
    const resp = await fetch(`/api/streams/${id}/status`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ status: 'live' })
    });
    const data = await resp.json();
    if (data.success) {
      window.location.reload();
    } else {
      alert('Error starting stream: ' + (data.error || 'Unknown error'));
    }
  } catch (err) {
    console.error('Error starting stream:', err);
    alert('Failed to start stream');
  }
}

async function stopStream(id) {
  if (!id) return;
  try {
    const resp = await fetch(`/api/streams/${id}/status`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ status: 'offline' })
    });
    const data = await resp.json();
    if (data.success) {
      window.location.reload();
    } else {
      alert('Error stopping stream: ' + (data.error || 'Unknown error'));
    }
  } catch (err) {
    console.error('Error stopping stream:', err);
    alert('Failed to stop stream');
  }
}

async function editStream(id) {
  if (!id) return;
  try {
    const resp = await fetch(`/api/streams/${id}`);
    const data = await resp.json();
    if (!data.success) {
      alert('Error fetching stream');
      return;
    }
    // Open edit modal with stream data
    openEditStreamModal(data.stream);
  } catch (err) {
    console.error('Error editing stream:', err);
    alert('Failed to edit stream');
  }
}

function openEditStreamModal(stream) {
  const modal = document.getElementById('editStreamModal');
  if (!modal) {
    console.error('Edit modal not found');
    return;
  }

  // Populate form fields
  document.getElementById('editStreamId').value = stream.id;
  document.getElementById('editStreamTitle').value = stream.title || '';
  document.getElementById('editLoopVideo').checked = stream.loop_video || false;
  document.getElementById('editScheduleInput').value = stream.schedule_time ? stream.schedule_time.slice(0, 16) : '';
  document.getElementById('editDurationInput').value = stream.duration || '';

  // Advanced settings
  document.getElementById('editBitrateSelect').value = stream.bitrate || 2500;
  document.getElementById('editFpsSelect').value = stream.fps || 30;
  document.getElementById('editResolutionSelect').value = stream.resolution || '720';
  document.getElementById('editCurrentResolution').textContent = stream.resolution || '1280x720';

  // First refresh the channel list to ensure we have the latest channels
  if (typeof populateChannels === 'function') {
    populateChannels(); // This will populate both create and edit channel selects
  }

  // Find and select the matching channel based on RTMP URL and Stream Key
  const channelSelect = document.getElementById('editChannelSelect');
  if (channelSelect && stream.rtmp_url && stream.stream_key) {
    // Find the matching channel by comparing RTMP URL and Stream Key
    for (let i = 0; i < channelSelect.options.length; i++) {
      const option = channelSelect.options[i];
      const optionText = option.textContent;

      // This is a simple approach - we'll check if we can match by value (channel ID) when the channels are loaded
      // The actual selection will be handled by async logic after channel data is processed
      if (option.value && option.value !== '') {
        // We'll select this channel option after we've matched it with the stream's RTMP details
        // For now, we'll mark it as a potential match
        continue; // We need to implement async selection below
      }
    }

    // Since this needs async processing, we'll handle it separately
    setTimeout(async () => {
      if (stream.rtmp_url && stream.stream_key) {
        try {
          const response = await fetch('/api/channels');
          const data = await response.json();

          if (data.success) {
            const channels = data.channels;
            const matchingChannel = channels.find(channel =>
              channel.rtmp_url === stream.rtmp_url && channel.stream_key === stream.stream_key
            );

            if (matchingChannel) {
              document.getElementById('editChannelSelect').value = matchingChannel.id;
            }
          }
        } catch (error) {
          console.error('Error finding matching channel for edit:', error);
        }
      }
    }, 100); // Small delay to allow the dropdown to populate
  }

  // Recurrence settings
  document.getElementById('editRecurrenceType').value = stream.recurrence_type || '';

  // Handle recurrence value based on type
  const recType = stream.recurrence_type || '';
  if (recType === 'weekly') {
    document.getElementById('editWeekdaySelector').classList.remove('hidden');
    document.getElementById('editMonthdaySelector').classList.add('hidden');
    document.getElementById('editRecurrenceValue').value = stream.recurrence_value || '0';
  } else if (recType === 'monthly') {
    document.getElementById('editWeekdaySelector').classList.add('hidden');
    document.getElementById('editMonthdaySelector').classList.remove('hidden');
    document.getElementById('editRecurrenceValueNum').value = stream.recurrence_value || '';
  } else {
    document.getElementById('editWeekdaySelector').classList.add('hidden');
    document.getElementById('editMonthdaySelector').classList.add('hidden');
  }
  
  // Show modal with animation (same behavior as new stream modal)
  document.body.style.overflow = 'hidden';
  modal.classList.remove('hidden');
  // ensure any previous active state removed then add for animation
  modal.classList.remove('active');
  requestAnimationFrame(() => {
    modal.classList.add('active');
  });

  // close when clicking on overlay
  modal.addEventListener('click', function onOverlayClick(e) {
    if (e.target === modal) {
      closeEditStreamModal();
    }
  });

  console.log('Edit modal opened for stream:', stream.id);
}

function closeEditStreamModal() {
  const modal = document.getElementById('editStreamModal');
  if (modal) {
    // reverse animation then hide
    document.body.style.overflow = 'auto';
    modal.classList.remove('active');
    setTimeout(() => {
      modal.classList.add('hidden');
    }, 200);
  }
}

async function saveEditStream() {
  const streamId = document.getElementById('editStreamId').value;
  if (!streamId) return;

  const channelId = document.getElementById('editChannelSelect').value;
  if (!channelId) {
    alert('Please select a channel before updating the stream');
    const channelSelect = document.getElementById('editChannelSelect');
    channelSelect.focus();
    return;
  }

  // Get channel details to fill in RTMP URL and Stream Key
  try {
    const channelResponse = await fetch(`/api/channels/${channelId}`);
    const channelData = await channelResponse.json();

    if (!channelData.success) {
      alert('Failed to get channel details. Please try again.');
      return;
    }

    const channel = channelData.channel;

    // Get recurrence value based on type
    const recType = document.getElementById('editRecurrenceType').value;
    let recValue = '';
    if (recType === 'weekly') {
      recValue = document.getElementById('editRecurrenceValue').value;
    } else if (recType === 'monthly') {
      recValue = document.getElementById('editRecurrenceValueNum').value;
    }

    // Determine if advanced settings should be used
    const editAdvancedSettingsContent = document.getElementById('editAdvancedSettingsContent');
    const isEditAdvancedPanelOpen = editAdvancedSettingsContent ? !editAdvancedSettingsContent.classList.contains('hidden') : false;
    const editBitrateValue = parseInt(document.getElementById('editBitrateSelect').value) || 2500;
    const editFpsValue = parseInt(document.getElementById('editFpsSelect').value) || 30;
    const editResolutionValue = document.getElementById('editResolutionSelect').value || '720';
    
    // Check if user changed any advanced settings from defaults
    const hasEditNonDefaultSettings = editBitrateValue !== 2500 || editFpsValue !== 30 || editResolutionValue !== '720';
    const shouldUseEditAdvancedSettings = isEditAdvancedPanelOpen || hasEditNonDefaultSettings;

    const body = {
      streamTitle: document.getElementById('editStreamTitle').value,
      rtmpUrl: channel.rtmp_url,
      streamKey: channel.stream_key,
      platform: channel.platform,
      platform_icon: channel.platform_icon,
      bitrate: editBitrateValue,
      fps: editFpsValue,
      resolution: editResolutionValue,
      loopVideo: document.getElementById('editLoopVideo').checked,
      scheduleTime: document.getElementById('editScheduleInput').value,
      duration: document.getElementById('editDurationInput').value,
      recurrenceType: recType,
      recurrenceValue: recValue || null,
      useAdvancedSettings: shouldUseEditAdvancedSettings
    };

    try {
      const resp = await fetch(`/api/streams/${streamId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
      const data = await resp.json();
      if (data.success) {
        alert('Stream updated successfully');
        closeEditStreamModal();
        window.location.reload();
      } else {
        alert('Error updating stream: ' + (data.error || 'Failed to update'));
      }
    } catch (err) {
      console.error('Error updating stream:', err);
      alert('Failed to update stream');
    }
  } catch (error) {
    console.error('Error fetching channel details:', error);
    alert('Failed to fetch channel details');
  }
}

function toggleEditStreamKeyVisibility() {
  const input = document.getElementById('editStreamKey');
  const toggle = document.getElementById('editStreamKeyToggle');
  if (input.type === 'password') {
    input.type = 'text';
    toggle.classList.remove('ti-eye');
    toggle.classList.add('ti-eye-off');
  } else {
    input.type = 'password';
    toggle.classList.remove('ti-eye-off');
    toggle.classList.add('ti-eye');
  }
}

async function deleteStream(id) {
  if (!id) return;
  if (!confirm('Are you sure you want to delete this stream?')) return;
  try {
    const resp = await fetch(`/api/streams/${id}`, {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' }
    });
    const data = await resp.json();
    if (data.success) {
      window.location.reload();
    } else {
      alert('Error deleting stream: ' + (data.error || 'Failed to delete'));
    }
  } catch (err) {
    console.error('Error deleting stream:', err);
    alert('Failed to delete stream');
  }
}

// Helper function to initialize empty channel dropdowns
function initializeEmptyChannelDropdowns() {
  const createChannelSelect = document.getElementById('channelSelect');
  const editChannelSelect = document.getElementById('editChannelSelect');
  
  [createChannelSelect, editChannelSelect].forEach(select => {
    if (select) {
      select.innerHTML = '';
      const defaultOption = document.createElement('option');
      defaultOption.value = '';
      defaultOption.textContent = 'No channels available - Please add a channel first';
      select.appendChild(defaultOption);
    }
  });
}

// Direct function to fetch and populate channels
async function loadChannelsIntoSelects() {
  try {
    const response = await fetch('/api/channels');
    
    // Check if response is OK
    if (!response.ok) {
      console.error('Failed to load channels: HTTP', response.status);
      console.log('Creating empty channel list as fallback');
      // Initialize empty dropdowns
      initializeEmptyChannelDropdowns();
      return;
    }
    
    const data = await response.json();

    if (!data.success) {
      console.error('Failed to load channels:', data.error);
      initializeEmptyChannelDropdowns();
      return;
    }

    const channels = data.channels || [];

    // Populate create stream channel select
    const createChannelSelect = document.getElementById('channelSelect');
    if (createChannelSelect) {
      // Clear existing options except the default one
      while (createChannelSelect.children.length > 1) {
        createChannelSelect.removeChild(createChannelSelect.lastChild);
      }

      // Add default option
      const defaultOption = document.createElement('option');
      defaultOption.value = '';
      defaultOption.textContent = 'Select a channel...';
      createChannelSelect.appendChild(defaultOption);

      // Add channel options
      channels.forEach(channel => {
        const option = document.createElement('option');
        option.value = channel.id;
        option.textContent = `${channel.name} (${channel.platform})`;
        createChannelSelect.appendChild(option);
      });
    }

    // Populate edit stream channel select
    const editChannelSelect = document.getElementById('editChannelSelect');
    if (editChannelSelect) {
      // Clear existing options except the default one
      while (editChannelSelect.children.length > 1) {
        editChannelSelect.removeChild(editChannelSelect.lastChild);
      }

      // Add default option
      const defaultOption = document.createElement('option');
      defaultOption.value = '';
      defaultOption.textContent = 'Select a channel...';
      editChannelSelect.appendChild(defaultOption);

      // Add channel options
      channels.forEach(channel => {
        const option = document.createElement('option');
        option.value = channel.id;
        option.textContent = `${channel.name} (${channel.platform})`;
        editChannelSelect.appendChild(option);
      });
    }
  } catch (error) {
    console.error('Error loading channels:', error);
  }
}

// Ensure channels are loaded when the page is ready
document.addEventListener('DOMContentLoaded', function() {
  loadChannelsIntoSelects();
});

// Functions for channel combobox refresh functionality
async function refreshChannels() {
  const refreshIcon = document.getElementById('channelRefreshIcon');
  if (refreshIcon) {
    refreshIcon.classList.add('animate-spin');
  }

  try {
    await loadChannelsIntoSelects();
    // Simple fallback for showToast if not defined
    if (typeof showToast === 'function') {
      showToast('success', 'Channels refreshed successfully');
    } else {
      console.log('Channels refreshed successfully');
    }
  } catch (error) {
    console.error('Error refreshing channels:', error);
    if (typeof showToast === 'function') {
      showToast('error', 'Failed to refresh channels');
    } else {
      alert('Failed to refresh channels');
    }
  } finally {
    if (refreshIcon) {
      refreshIcon.classList.remove('animate-spin');
    }
  }
}

