// Save new stream function
async function saveNewStream() {
  const videoId = document.getElementById('selectedVideoId').value;
  if (!videoId) {
    alert('Please select a video before creating the stream');
    return;
  }

  const channelId = document.getElementById('channelSelect').value;
  if (!channelId) {
    alert('Please select a channel before creating the stream');
    const channelSelect = document.getElementById('channelSelect');
    channelSelect.focus();
    return;
  }

  // Get channel details to fill in RTMP URL and Stream Key
  try {
    const channelResponse = await fetch(`/api/channels/${channelId}`);
    const channelData = await channelResponse.json();

    if (!channelData.success) {
      alert('Failed to get channel details. Please try again.');
      return;
    }

    const channel = channelData.channel;

    // Get recurrence value based on type
    const recType = document.getElementById('recurrenceType').value;
    let recValue = '';
    if (recType === 'weekly') {
      recValue = document.getElementById('recurrenceValue').value;
    } else if (recType === 'monthly') {
      recValue = document.getElementById('recurrenceValue').value;
    }

    // Determine if advanced settings should be used
    const advancedSettingsContent = document.getElementById('advancedSettingsContent');
    const isAdvancedPanelOpen = advancedSettingsContent ? !advancedSettingsContent.classList.contains('hidden') : false;
    const bitrateValue = parseInt(document.getElementById('bitrateSelect').value) || 2500;
    const fpsValue = parseInt(document.getElementById('fpsSelect').value) || 30;
    const resolutionValue = document.getElementById('resolutionSelect').value || '720';
    
    // Check if user changed any advanced settings from defaults
    const hasNonDefaultSettings = bitrateValue !== 2500 || fpsValue !== 30 || resolutionValue !== '720';
    const shouldUseAdvancedSettings = isAdvancedPanelOpen || hasNonDefaultSettings;

    const body = {
      videoId: videoId,
      streamTitle: document.getElementById('streamTitle').value,
      rtmpUrl: channel.rtmp_url,
      streamKey: channel.stream_key,
      platform: channel.platform,
      platform_icon: channel.platform_icon,
      bitrate: bitrateValue,
      fps: fpsValue,
      resolution: resolutionValue,
      loopVideo: document.getElementById('newStreamForm').loopVideo.checked,
      scheduleTime: document.getElementById('scheduleInput').value,
      duration: document.getElementById('durationInput').value,
      recurrenceType: recType,
      recurrenceValue: recValue || null,
      useAdvancedSettings: shouldUseAdvancedSettings
    };

    try {
      const resp = await fetch('/api/streams', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
      const data = await resp.json();
      if (data.success) {
        alert('Stream created successfully');
        closeNewStreamModal();
        window.location.reload();
      } else {
        alert('Error creating stream: ' + (data.error || 'Failed to create'));
      }
    } catch (err) {
      console.error('Error creating stream:', err);
      alert('Failed to create stream');
    }
  } catch (error) {
    console.error('Error fetching channel details:', error);
    alert('Failed to fetch channel details');
  }
}

// Event listener for new stream form submission
document.addEventListener('DOMContentLoaded', function() {
  const newStreamForm = document.getElementById('newStreamForm');
  if (newStreamForm) {
    newStreamForm.addEventListener('submit', async function(e) {
      e.preventDefault();
      await saveNewStream();
    });
  }
});
</script>
