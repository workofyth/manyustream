// Recurrence type toggle for EDIT modal
document.addEventListener('DOMContentLoaded', function () {
  const editRecurrenceTypeSelect = document.getElementById('editRecurrenceType');
  const editWeekdaySelector = document.getElementById('editWeekdaySelector');
  const editMonthdaySelector = document.getElementById('editMonthdaySelector');
  
  if (editRecurrenceTypeSelect) {
