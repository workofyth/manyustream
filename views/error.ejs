<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - StreamFlow</title>
  <link rel="icon" href="/images/logo.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@2.30.0/tabler-icons.min.css">
  <link rel="stylesheet" href="/css/styles.css">

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        fontFamily: {
          'inter': ['Inter', 'sans-serif'],
          'sans': ['Inter', 'system-ui', 'sans-serif']
        },
        extend: {
          colors: {
            'primary': '#3C50E0',
            'secondary': '#80CAEE',
            'body': '#64748B',
            'bodydark': '#AEB7C0',
            'stroke': '#E2E8F0',
            'gray': '#EFF4FB',
            'whiten': '#F1F5F9',
            'boxdark': '#24303F',
            'boxdark-2': '#1A222C',
            'danger': '#D34053',
          }
        }
      }
    }
  </script>
</head>

<body class="bg-whiten dark:bg-boxdark-2">
  <div class="flex h-screen items-center justify-center px-4">
    <div class="w-full max-w-md">
      <!-- Logo -->
      <div class="mb-8 flex justify-center">
        <img src="/images/logo.svg" alt="StreamFlow Logo" class="h-16">
      </div>

      <!-- Error Card -->
      <div class="rounded-sm border border-stroke bg-white shadow-default dark:border-strokedark dark:bg-boxdark p-8 text-center">
        <!-- Error Icon -->
        <div class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-danger bg-opacity-10">
          <i class="ti ti-alert-triangle text-4xl text-danger"></i>
        </div>

        <!-- Error Content -->
        <h2 class="mb-3 text-2xl font-bold text-black dark:text-white">
          Oops! Something went wrong
        </h2>
        <p class="mb-6 text-bodydark">
          <%= error %>
        </p>

        <!-- Actions -->
        <div class="flex flex-col gap-3 sm:flex-row sm:justify-center">
          <a href="/"
            class="inline-flex items-center justify-center gap-2 rounded-md bg-primary py-3 px-6 text-center font-medium text-white hover:bg-opacity-90">
            <i class="ti ti-home"></i>
            <span>Back to Home</span>
          </a>
          <button onclick="window.history.back()"
            class="inline-flex items-center justify-center gap-2 rounded-md border border-stroke py-3 px-6 text-center font-medium text-black hover:shadow-1 dark:border-strokedark dark:text-white">
            <i class="ti ti-arrow-left"></i>
            <span>Go Back</span>
          </button>
        </div>
      </div>

      <!-- Footer -->
      <div class="mt-6 text-center">
        <p class="text-sm text-bodydark">
          Need help? <a href="https://github.com/bangtutorial/streamflow/issues" target="_blank" class="text-primary hover:underline">Contact Support</a>
        </p>
      </div>
    </div>
  </div>
</body>

</html>