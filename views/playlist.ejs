<% layout('layout') -%>

<!-- Page Heading -->
<div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
  <div>
    <h2 class="text-title-md2 font-semibold text-black dark:text-white">
      Playlist Manager
    </h2>
    <p class="text-sm text-bodydark mt-1">Create and manage video playlists for streaming</p>
  </div>
  
  <button onclick="openCreatePlaylistModal()"
    class="inline-flex items-center justify-center gap-2 rounded-md bg-primary py-2.5 px-4 text-center font-medium text-white hover:bg-opacity-90">
    <i class="ti ti-plus"></i>
    <span>Create Playlist</span>
  </button>
</div>

<!-- Search & Filter -->
<div class="mb-6 rounded-sm border border-stroke bg-white shadow-default dark:border-strokedark dark:bg-boxdark p-4">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
    <div class="relative flex-1 max-w-md">
      <input type="text" id="searchPlaylists" placeholder="Search playlists..."
        class="w-full rounded-lg border border-stroke bg-transparent py-2.5 pl-10 pr-4 text-black outline-none focus:border-primary focus-visible:shadow-none dark:border-strokedark dark:bg-meta-4 dark:text-white dark:focus:border-primary">
      <i class="ti ti-search absolute left-3 top-1/2 -translate-y-1/2 text-bodydark"></i>
    </div>
    
    <select id="sortPlaylists"
      class="rounded-lg border border-stroke bg-transparent py-2.5 px-4 text-black outline-none focus:border-primary dark:border-strokedark dark:bg-meta-4 dark:text-white">
      <option value="newest">Newest First</option>
      <option value="oldest">Oldest First</option>
      <option value="name">Name (A-Z)</option>
    </select>
  </div>
</div>

<!-- Playlists Grid -->
<div id="playlistsContainer" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
  <% if (playlists && playlists.length > 0) { %>
    <% playlists.forEach(function(playlist) { %>
      <div class="rounded-sm border border-stroke bg-white shadow-default dark:border-strokedark dark:bg-boxdark overflow-hidden playlist-card" 
           data-playlist-id="<%= playlist.id %>" 
           data-created-at="<%= playlist.created_at %>" 
           data-updated-at="<%= playlist.updated_at %>">
        <!-- Playlist Header -->
        <div class="border-b border-stroke px-5 py-4 dark:border-strokedark">
          <div class="flex items-start justify-between">
            <div class="flex-1 min-w-0">
              <h5 class="font-semibold text-black dark:text-white truncate" title="<%= playlist.name %>">
                <%= playlist.name %>
              </h5>
              <p class="mt-1 text-sm text-bodydark line-clamp-2">
                <%= playlist.description || 'No description' %>
              </p>
            </div>
          </div>
        </div>
        
        <!-- Playlist Info -->
        <div class="p-5">
          <div class="mb-4 flex items-center justify-between text-sm">
            <div class="flex items-center gap-2 text-bodydark">
              <i class="ti ti-video"></i>
              <span><%= playlist.video_count || 0 %> videos</span>
            </div>
            <div class="flex items-center gap-1.5 rounded-full bg-gray-2 px-3 py-1 dark:bg-meta-4">
              <i class="ti ti-<%= (playlist.shuffle || playlist.is_shuffle) ? 'arrows-shuffle' : 'list-numbers' %> text-sm"></i>
              <span class="text-xs font-medium">
                <%= (playlist.shuffle || playlist.is_shuffle) ? 'Shuffle' : 'Sequential' %>
              </span>
            </div>
          </div>
          
          <!-- Actions -->
          <div class="flex items-center gap-2">
            <button onclick="viewPlaylist('<%= playlist.id %>')"
              class="flex-1 inline-flex items-center justify-center gap-1.5 rounded-md bg-primary py-2 px-3 text-sm font-medium text-white hover:bg-opacity-90">
              <i class="ti ti-eye"></i>
              <span>View</span>
            </button>
            <button onclick="editPlaylist('<%= playlist.id %>')"
              class="inline-flex items-center justify-center rounded-md bg-meta-3 py-2 px-3 text-white hover:bg-opacity-90">
              <i class="ti ti-pencil"></i>
            </button>
            <button onclick="deletePlaylist('<%= playlist.id %>', '<%= playlist.name %>')"
              class="inline-flex items-center justify-center rounded-md bg-meta-1 py-2 px-3 text-white hover:bg-opacity-90">
              <i class="ti ti-trash"></i>
            </button>
          </div>
        </div>
      </div>
    <% }); %>
  <% } else { %>
    <!-- Empty State -->
    <div class="col-span-full rounded-sm border border-stroke bg-white shadow-default dark:border-strokedark dark:bg-boxdark p-12 text-center">
      <div class="flex flex-col items-center justify-center">
        <i class="ti ti-playlist-off text-6xl text-bodydark mb-4"></i>
        <h3 class="mb-2 text-xl font-semibold text-black dark:text-white">No Playlists Yet</h3>
        <p class="mb-6 text-bodydark">Create your first playlist to organize your videos</p>
        <button onclick="openCreatePlaylistModal()"
          class="inline-flex items-center justify-center gap-2 rounded-md bg-primary py-2.5 px-6 text-center font-medium text-white hover:bg-opacity-90">
          <i class="ti ti-plus"></i>
          <span>Create Playlist</span>
        </button>
      </div>
    </div>
  <% } %>
</div>

<!-- Create/Edit Playlist Modal -->
<div id="playlistModal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50">
  <div class="bg-white dark:bg-boxdark rounded-lg p-6 w-full max-w-4xl mx-4 max-h-[90vh] overflow-y-auto">
    <div class="flex items-center justify-between mb-6 pb-4 border-b border-stroke dark:border-strokedark">
      <h3 id="modalTitle" class="text-xl font-semibold text-black dark:text-white">Create New Playlist</h3>
      <button onclick="closePlaylistModal()" class="text-bodydark hover:text-black dark:hover:text-white">
        <i class="ti ti-x text-xl"></i>
      </button>
    </div>
    
    <form id="playlistForm" class="space-y-6">
      <input type="hidden" id="playlistId" name="playlistId">
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label for="playlistName" class="block text-sm font-medium mb-2 text-black dark:text-white">Playlist Name</label>
          <input type="text" id="playlistName" name="name" required placeholder="Enter playlist name..."
            class="w-full bg-white dark:bg-meta-4 text-black dark:text-white px-3 py-2 border border-stroke dark:border-strokedark rounded-lg focus:outline-none focus:ring-1 focus:ring-primary">
        </div>
        
        <div>
          <label for="playlistShuffle" class="block text-sm font-medium mb-2 text-black dark:text-white">Playback Mode</label>
          <select id="playlistShuffle" name="shuffle"
            class="w-full bg-white dark:bg-meta-4 border border-stroke dark:border-strokedark text-black dark:text-white px-3 py-2 rounded-lg focus:outline-none focus:ring-1 focus:ring-primary">
            <option value="false">Sequential</option>
            <option value="true">Shuffle</option>
          </select>
        </div>
      </div>
      
      <div>
        <label for="playlistDescription" class="block text-sm font-medium mb-2 text-black dark:text-white">Description (Optional)</label>
        <textarea id="playlistDescription" name="description" rows="3" placeholder="Enter playlist description (optional)..."
          class="w-full bg-white dark:bg-meta-4 text-black dark:text-white px-3 py-2 border border-stroke dark:border-strokedark rounded-lg focus:outline-none focus:ring-1 focus:ring-primary resize-none"></textarea>
      </div>
      
      <div>
        <label class="block text-sm font-medium mb-3 text-black dark:text-white">Select Videos</label>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <!-- Available Videos -->
          <div>
            <h4 class="text-sm font-medium mb-3 text-bodydark dark:text-bodydark1">Available Videos</h4>
            <div class="bg-white dark:bg-meta-4 rounded-lg border border-stroke dark:border-strokedark shadow-lg">
              <div class="p-2 border-b border-stroke dark:border-strokedark">
                <div class="relative">
                  <input type="text" id="searchVideos" placeholder="Search videos..."
                    class="w-full bg-white dark:bg-meta-4 text-black dark:text-white pl-8 pr-4 py-2 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-primary border border-stroke dark:border-strokedark">
                  <i class="ti ti-search absolute left-3 top-1/2 -translate-y-1/2 text-bodydark dark:text-bodydark1"></i>
                </div>
              </div>
              <div id="availableVideos" class="p-2 space-y-1 max-h-60 overflow-y-auto">
                <!-- Videos will be loaded here -->
              </div>
            </div>
          </div>
          
          <!-- Selected Videos -->
          <div>
            <h4 class="text-sm font-medium mb-3 text-bodydark dark:text-bodydark1">Playlist Videos</h4>
            <div class="bg-white dark:bg-meta-4 rounded-lg p-3 max-h-80 overflow-y-auto border border-stroke dark:border-strokedark">
              <div id="selectedVideos" class="space-y-2 min-h-[100px]">
                <p id="noVideosMessage" class="text-bodydark dark:text-bodydark1 text-sm text-center py-8">No videos selected</p>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <div class="flex justify-end gap-3 pt-4 border-t border-stroke dark:border-strokedark">
        <button type="button" onclick="closePlaylistModal()" 
          class="px-4 py-2 text-bodydark dark:text-bodydark1 hover:text-black dark:hover:text-white transition-colors">
          Cancel
        </button>
        <button type="submit" 
          class="bg-primary hover:bg-opacity-90 text-white px-6 py-2 rounded-lg transition-colors">
          <span id="submitButtonText">Create Playlist</span>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
// Search functionality
document.getElementById('searchPlaylists')?.addEventListener('input', function(e) {
  const searchTerm = e.target.value.toLowerCase();
  const cards = document.querySelectorAll('.playlist-card');
  
  cards.forEach(card => {
    const playlistName = card.querySelector('h5').textContent.toLowerCase();
    const playlistDesc = card.querySelector('.line-clamp-2').textContent.toLowerCase();
    
    if (playlistName.includes(searchTerm) || playlistDesc.includes(searchTerm)) {
      card.parentElement.style.display = '';
    } else {
      card.parentElement.style.display = 'none';
    }
  });
});

// Sort functionality
document.getElementById('sortPlaylists')?.addEventListener('change', function(e) {
  const sortBy = e.target.value;
  const container = document.getElementById('playlistsContainer');
  const cards = Array.from(container.children);
  
  cards.sort((a, b) => {
    const cardA = a.querySelector('.playlist-card');
    const cardB = b.querySelector('.playlist-card');
    
    if (!cardA || !cardB) return 0;
    
    switch(sortBy) {
      case 'newest':
        return new Date(cardB.dataset.createdAt) - new Date(cardA.dataset.createdAt);
      case 'oldest':
        return new Date(cardA.dataset.createdAt) - new Date(cardB.dataset.createdAt);
      case 'name':
        const nameA = cardA.querySelector('h5').textContent;
        const nameB = cardB.querySelector('h5').textContent;
        return nameA.localeCompare(nameB);
      default:
        return 0;
    }
  });
  
  cards.forEach(card => container.appendChild(card));
});

// Playlist Modal Functions
function openCreatePlaylistModal() {
  document.getElementById('playlistModal').classList.remove('hidden');
  document.getElementById('playlistModal').classList.add('flex');
  document.getElementById('modalTitle').textContent = 'Create New Playlist';
  document.getElementById('submitButtonText').textContent = 'Create Playlist';
  document.getElementById('playlistForm').reset();
  document.getElementById('playlistId').value = '';
  document.getElementById('selectedVideos').innerHTML = '<p id="noVideosMessage" class="text-bodydark dark:text-bodydark1 text-sm text-center py-8">No videos selected</p>';
  loadAvailableVideos();
}

function closePlaylistModal() {
  document.getElementById('playlistModal').classList.add('hidden');
  document.getElementById('playlistModal').classList.remove('flex');
}

function viewPlaylist(id) {
  window.location.href = '/playlist/' + id;
}

function editPlaylist(id) {
  fetch(`/api/playlists/${id}`)
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        const playlist = data.playlist;
        document.getElementById('playlistId').value = id;
        document.getElementById('playlistName').value = playlist.name;
        document.getElementById('playlistDescription').value = playlist.description || '';
        document.getElementById('playlistShuffle').value = (playlist.is_shuffle || playlist.shuffle) ? "true" : "false";
        
        document.getElementById('modalTitle').textContent = 'Edit Playlist';
        document.getElementById('submitButtonText').textContent = 'Update Playlist';
        
        // Load and display current videos with proper data attributes
        document.getElementById('selectedVideos').innerHTML = '';
        if (playlist.videos && playlist.videos.length > 0) {
          playlist.videos.forEach(video => {
            const videoDiv = document.createElement('div');
            videoDiv.className = 'flex items-center justify-between p-2 bg-gray-100 dark:bg-meta-4 rounded';
            videoDiv.dataset.videoId = video.id;
            videoDiv.innerHTML = `
              <div class="flex items-center gap-2 flex-1 min-w-0">
                <img src="${video.thumbnail_path || '/images/default-thumbnail.jpg'}" alt="${video.title}" 
                  class="w-10 h-8 rounded object-cover" onerror="this.src='/images/default-thumbnail.jpg'">
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium text-black dark:text-white truncate">${video.title}</p>
                </div>
              </div>
              <button type="button" onclick="removeVideoFromPlaylistForm('${video.id}')" 
                class="text-red-500 hover:text-red-700 ml-2">
                <i class="ti ti-x"></i>
              </button>
            `;
            document.getElementById('selectedVideos').appendChild(videoDiv);
          });
          if (document.getElementById('noVideosMessage')) {
            document.getElementById('noVideosMessage').style.display = 'none';
          }
        } else {
          if (!document.getElementById('noVideosMessage')) {
            const noMsg = document.createElement('p');
            noMsg.id = 'noVideosMessage';
            noMsg.className = 'text-bodydark dark:text-bodydark1 text-sm text-center py-8';
            noMsg.textContent = 'No videos selected';
            document.getElementById('selectedVideos').appendChild(noMsg);
          } else {
            document.getElementById('noVideosMessage').style.display = 'block';
          }
        }
        
        loadAvailableVideos();
        document.getElementById('playlistModal').classList.remove('hidden');
        document.getElementById('playlistModal').classList.add('flex');
      }
    })
    .catch(error => {
      console.error('Error loading playlist:', error);
      alert('Error loading playlist');
    });
}

function viewPlaylist(id) {
  window.location.href = '/playlist/' + id;
}

function deletePlaylist(id, name) {
  if (confirm('Are you sure you want to delete "' + name + '"? This action cannot be undone.')) {

    console.log('Delete playlist:', id);
    // TODO: Implement delete functionality
    // Send DELETE request to /api/playlists/{id}
  }
}

function loadAvailableVideos() {
  // Fetch videos from server
  fetch('/api/videos')
    .then(res => res.json())
    .then(data => {
      const container = document.getElementById('availableVideos');
      container.innerHTML = '';
      
      if (data.videos && data.videos.length > 0) {
        data.videos.forEach(video => {
          const div = document.createElement('button');
          div.type = 'button';
          div.className = 'w-full flex items-center space-x-3 p-2 rounded hover:bg-bodydark2 dark:hover:bg-meta-4 transition-colors text-left';
          div.dataset.videoId = video.id;
          div.onclick = (e) => {
            e.preventDefault();
            e.stopPropagation();
            addVideoToPlaylist(video.id, video.title);
          };
          
          const img = document.createElement('img');
          img.src = video.thumbnail_path || '/images/default-thumbnail.jpg';
          img.alt = video.title;
          img.className = 'w-16 h-12 rounded object-cover';
          img.onerror = () => img.src = '/images/default-thumbnail.jpg';
          
          const thumb = document.createElement('div');
          thumb.className = 'w-16 h-12 bg-bodydark rounded flex-shrink-0 overflow-hidden';
          thumb.appendChild(img);
          
          const titleEl = document.createElement('p');
          titleEl.className = 'text-sm font-medium text-black dark:text-white truncate';
          titleEl.textContent = video.title;
          
          const durationEl = document.createElement('p');
          durationEl.className = 'text-xs text-bodydark dark:text-bodydark1';
          if (video.duration) {
            const mins = Math.floor(video.duration / 60);
            const secs = String(Math.floor(video.duration % 60)).padStart(2, '0');
            durationEl.textContent = `${mins}:${secs}`;
          } else {
            durationEl.textContent = '0:00';
          }
          
          const textDiv = document.createElement('div');
          textDiv.className = 'flex-1 min-w-0 ml-3';
          textDiv.appendChild(titleEl);
          textDiv.appendChild(durationEl);
          
          div.appendChild(thumb);
          div.appendChild(textDiv);
          container.appendChild(div);
        });
      } else {
        container.innerHTML = '<div class="text-center py-5 text-bodydark dark:text-bodydark1">No videos available</div>';
      }
    })
    .catch(err => {
      console.error('Error loading videos:', err);
      document.getElementById('availableVideos').innerHTML = '<div class="text-center py-5 text-meta-1">Error loading videos</div>';
    });
}

function addVideoToPlaylist(videoId, videoTitle) {
  const selectedDiv = document.getElementById('selectedVideos');
  const noVideoMsg = document.getElementById('noVideosMessage');
  
  // Check if video already selected
  const existing = selectedDiv.querySelector(`[data-video-id="${videoId}"]`);
  if (existing) {
    return;
  }
  
  // Remove "no videos" message if this is the first video
  if (noVideoMsg) {
    noVideoMsg.remove();
  }
  
  // Create video item
  const div = document.createElement('div');
  div.className = 'flex items-center justify-between p-2 bg-bodydark2 dark:bg-meta-4 rounded';
  div.dataset.videoId = videoId;
  
  const label = document.createElement('span');
  label.className = 'text-sm text-black dark:text-white truncate';
  label.textContent = videoTitle;
  
  const btn = document.createElement('button');
  btn.type = 'button';
  btn.className = 'text-meta-1 hover:text-red-600 ml-2';
  btn.innerHTML = '<i class="ti ti-x"></i>';
  btn.onclick = (e) => {
    e.preventDefault();
    div.remove();
    // Check if empty
    if (selectedDiv.children.length === 0) {
      selectedDiv.innerHTML = '<p id="noVideosMessage" class="text-bodydark dark:text-bodydark1 text-sm text-center py-8">No videos selected</p>';
    }
  };
  
  div.appendChild(label);
  div.appendChild(btn);
  selectedDiv.appendChild(div);
}

function removeVideoFromPlaylistForm(videoId) {
  const selectedDiv = document.getElementById('selectedVideos');
  const videoDiv = selectedDiv.querySelector(`[data-video-id="${videoId}"]`);
  if (videoDiv) {
    videoDiv.remove();
    // Check if empty
    if (selectedDiv.children.length === 0) {
      selectedDiv.innerHTML = '<p id="noVideosMessage" class="text-bodydark dark:text-bodydark1 text-sm text-center py-8">No videos selected</p>';
    }
  }
}

// Handle form submission
document.getElementById('playlistForm')?.addEventListener('submit', async (e) => {
  e.preventDefault();
  
  const videos = Array.from(document.getElementById('selectedVideos').querySelectorAll('[data-video-id]'))
    .map(el => el.dataset.videoId);
  
  const formData = {
    name: document.getElementById('playlistName').value,
    description: document.getElementById('playlistDescription').value,
    shuffle: document.getElementById('playlistShuffle').value === 'true',
    videos: videos
  };
  
  const playlistId = document.getElementById('playlistId').value;
  const url = playlistId ? `/api/playlists/${playlistId}` : '/api/playlists';
  const method = playlistId ? 'PUT' : 'POST';
  
  try {
    const response = await fetch(url, {
      method: method,
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify(formData)
    });
    
    if (response.ok) {
      closePlaylistModal();
      window.location.reload();
    } else {
      alert('Error: ' + (await response.text()));
    }
  } catch (error) {
    console.error('Error:', error);
    alert('Error creating/updating playlist');
  }
});

// Search videos in modal
document.getElementById('searchVideos')?.addEventListener('input', function(e) {
  const searchTerm = e.target.value.toLowerCase();
  const buttons = document.getElementById('availableVideos').querySelectorAll('button');
  
  buttons.forEach(btn => {
    const title = btn.textContent.toLowerCase();
    btn.style.display = title.includes(searchTerm) ? '' : 'none';
  });
});
</script>
