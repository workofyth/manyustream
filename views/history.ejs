<% layout('layout') -%>

<!-- Page Heading -->
<div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
  <div>
    <h2 class="text-title-md2 font-semibold text-black dark:text-white">
      Stream History
    </h2>
    <p class="text-sm text-bodydark mt-1">View and manage your streaming history</p>
  </div>
</div>

<!-- Details Modal -->
<div id="history-details-modal" class="fixed inset-0 z-50 hidden items-center justify-center">
  <div class="modal-overlay absolute inset-0 bg-black opacity-50"></div>
  <div class="relative w-full max-w-2xl mx-auto bg-white dark:bg-boxdark rounded-lg shadow-lg overflow-hidden">
    <div class="p-4 border-b border-stroke dark:border-strokedark flex items-center justify-between">
      <h3 class="font-semibold text-black dark:text-white">Stream Details</h3>
      <button onclick="closeHistoryDetails()" class="text-bodydark hover:text-black">✕</button>
    </div>
    <div class="p-4 space-y-3">
      <div class="flex items-start gap-4">
        <div class="w-36 h-24 bg-gray-100 dark:bg-meta-4 overflow-hidden rounded">
          <img id="history-detail-thumb" src="/images/default-video-thumbnail.svg" alt="thumbnail" class="w-full h-full object-cover">
        </div>
        <div class="flex-1">
          <h4 id="history-detail-title" class="font-semibold text-black dark:text-white">-</h4>
          <p id="history-detail-platform" class="text-sm text-bodydark mt-1">-</p>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <div class="text-xs text-bodydark">Start</div>
          <div id="history-detail-start" class="text-black dark:text-white">-</div>
        </div>
        <div>
          <div class="text-xs text-bodydark">Stop</div>
          <div id="history-detail-stop" class="text-black dark:text-white">-</div>
        </div>
        <div>
          <div class="text-xs text-bodydark">Duration</div>
          <div id="history-detail-duration" class="text-black dark:text-white">-</div>
        </div>
        <div>
          <div class="text-xs text-bodydark">Video</div>
          <div id="history-detail-video" class="text-black dark:text-white">-</div>
        </div>
      </div>
    </div>
    <div class="p-3 border-t border-stroke dark:border-strokedark text-right">
      <button onclick="closeHistoryDetails()" class="py-2 px-4 rounded bg-gray-200 dark:bg-meta-3">Close</button>
    </div>
  </div>
</div>

<!-- Filters -->
<div class="mb-6 rounded-sm border border-stroke bg-white shadow-default dark:border-strokedark dark:bg-boxdark p-4">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
    <div class="relative flex-1 max-w-md">
      <input type="text" id="history-search" placeholder="Search streams..."
        class="w-full rounded-lg border border-stroke bg-transparent py-2.5 pl-10 pr-4 text-black outline-none focus:border-primary focus-visible:shadow-none dark:border-strokedark dark:bg-meta-4 dark:text-white dark:focus:border-primary">
      <i class="ti ti-search absolute left-3 top-1/2 -translate-y-1/2 text-bodydark"></i>
    </div>
    
    <select id="platform-filter"
      class="rounded-lg border border-stroke bg-transparent py-2.5 px-4 text-black outline-none focus:border-primary dark:border-strokedark dark:bg-meta-4 dark:text-white">
      <option value="all">All Platforms</option>
      <option value="YouTube">YouTube</option>
      <option value="Facebook">Facebook</option>
      <option value="Twitch">Twitch</option>
      <option value="TikTok">TikTok</option>
      <option value="Instagram">Instagram</option>
      <option value="Custom">Custom</option>
    </select>
  </div>
</div>

<!-- History Table -->
<div class="rounded-sm border border-stroke bg-white shadow-default dark:border-strokedark dark:bg-boxdark">
  <div class="max-w-full overflow-x-auto">
    <table class="w-full table-auto">
      <thead>
        <tr class="bg-gray-2 text-left dark:bg-meta-4">
          <th class="min-w-[250px] py-4 px-4 font-medium text-black dark:text-white xl:pl-11">
            Stream Name
          </th>
          <th class="min-w-[120px] py-4 px-4 font-medium text-black dark:text-white">
            Platform
          </th>
          <th class="min-w-[150px] py-4 px-4 font-medium text-black dark:text-white">
            Start Time
          </th>
          <th class="min-w-[150px] py-4 px-4 font-medium text-black dark:text-white">
            Stop Time
          </th>
          <th class="min-w-[100px] py-4 px-4 font-medium text-black dark:text-white">
            Duration
          </th>
          <th class="py-4 px-4 font-medium text-black dark:text-white">
            Actions
          </th>
        </tr>
      </thead>
      <tbody id="history-table-body">
        <% if (history && history.length > 0) { %>
          <% history.forEach(function(entry) { %>
            <tr class="border-b border-stroke dark:border-strokedark hover:bg-gray-2 dark:hover:bg-meta-4" 
              data-id="<%= entry.id %>"
              data-platform="<%= entry.platform %>" 
              data-title="<%= entry.title %>"
              data-start="<%= entry.start_time %>"
              data-stop="<%= entry.stop_time %>"
              data-duration="<%= entry.duration %>"
              data-thumbnail="<%= entry.thumbnail_path || '' %>"
              >
              <!-- Stream Name -->
              <td class="border-b border-stroke py-5 px-4 pl-9 dark:border-strokedark xl:pl-11">
                <div class="flex items-center gap-3">
                  <div class="flex-shrink-0 h-12 w-20 overflow-hidden rounded bg-gray-2 dark:bg-meta-4">
                    <% if (entry.thumbnail_path) { %>
                      <img src="<%= entry.thumbnail_path %>" 
                           class="h-full w-full object-cover" 
                           alt="<%= entry.title %>"
                           onerror="this.src='/images/default-video-thumbnail.svg'">
                    <% } else { %>
                      <div class="flex h-full w-full items-center justify-center">
                        <i class="ti ti-video text-2xl text-bodydark"></i>
                      </div>
                    <% } %>
                  </div>
                  <h5 class="font-medium text-black dark:text-white">
                    <%= entry.title %>
                  </h5>
                </div>
              </td>
              
              <!-- Platform -->
              <td class="border-b border-stroke py-5 px-4 dark:border-strokedark">
                <div class="flex items-center gap-2">
                  <i class="ti ti-brand-<%= helpers.getPlatformIcon(entry.platform) %> text-xl"></i>
                  <span class="text-black dark:text-white"><%= entry.platform || 'Custom' %></span>
                </div>
              </td>
              
              <!-- Start Time -->
              <td class="border-b border-stroke py-5 px-4 dark:border-strokedark">
                <p class="text-black dark:text-white">
                  <%= entry.start_time ? helpers.formatDateTime(entry.start_time) : '-' %>
                </p>
              </td>
              
              <!-- Stop Time -->
              <td class="border-b border-stroke py-5 px-4 dark:border-strokedark">
                <p class="text-black dark:text-white">
                  <%= entry.stop_time ? helpers.formatDateTime(entry.stop_time) : '-' %>
                </p>
              </td>
              
              <!-- Duration -->
              <td class="border-b border-stroke py-5 px-4 dark:border-strokedark">
                <% if (entry.duration) { %>
                  <p class="text-black dark:text-white"><%= helpers.formatDuration(entry.duration) %></p>
                <% } else if (entry.start_time && entry.stop_time) { 
                  const duration = Math.floor((new Date(entry.stop_time) - new Date(entry.start_time)) / 1000);
                  const hours = Math.floor(duration / 3600);
                  const minutes = Math.floor((duration % 3600) / 60);
                %>
                  <p class="text-black dark:text-white">
                    <%= hours > 0 ? hours + 'h ' : '' %><%= minutes %>m
                  </p>
                <% } else { %>
                  <p class="text-bodydark">-</p>
                <% } %>
              </td>
              
              <!-- Actions -->
              <td class="border-b border-stroke py-5 px-4 dark:border-strokedark">
                <div class="flex items-center space-x-3.5">
                  <button class="hover:text-primary" onclick="viewDetails('<%= entry.id %>')">
                    <i class="ti ti-eye text-lg"></i>
                  </button>
                  <button class="hover:text-danger" onclick="deleteHistory('<%= entry.id %>', '<%= entry.title %>')">
                    <i class="ti ti-trash text-lg"></i>
                  </button>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="6" class="border-b border-stroke py-5 px-4 text-center dark:border-strokedark">
              <div class="flex flex-col items-center justify-center py-8">
                <i class="ti ti-history-off text-6xl text-bodydark mb-3"></i>
                <p class="text-bodydark">No streaming history yet</p>
              </div>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<script>
// CSRF token for AJAX calls
const __csrfToken = '<%= csrfToken %>';

function showToast(message, type = 'info') {
  let container = document.getElementById('toast-container');
  if (!container) {
    container = document.createElement('div');
    container.id = 'toast-container';
    container.className = 'fixed right-4 bottom-4 z-60 flex flex-col gap-2 items-end';
    document.body.appendChild(container);
  }

  const el = document.createElement('div');
  el.className = 'px-4 py-2 rounded shadow text-sm text-white';
  if (type === 'error') el.style.background = '#f56565';
  else if (type === 'success') el.style.background = '#48bb78';
  else el.style.background = '#2b6cb0';
  el.textContent = message;
  container.appendChild(el);
  setTimeout(() => {
    el.style.opacity = '0';
    setTimeout(() => el.remove(), 300);
  }, 3000);
}

// Search functionality
document.getElementById('history-search')?.addEventListener('input', function(e) {
  filterHistory();
});

// Platform filter
document.getElementById('platform-filter')?.addEventListener('change', function(e) {
  filterHistory();
});

function filterHistory() {
  const searchTerm = document.getElementById('history-search').value.toLowerCase();
  const platformFilter = document.getElementById('platform-filter').value;
  const rows = document.querySelectorAll('#history-table-body tr[data-id]');
  
  rows.forEach(row => {
    const title = (row.dataset.title || '').toLowerCase();
    const platform = row.dataset.platform || '';
    
    const matchesSearch = title.includes(searchTerm);
    const matchesPlatform = platformFilter === 'all' || platform === platformFilter;
    
    if (matchesSearch && matchesPlatform) {
      row.style.display = '';
    } else {
      row.style.display = 'none';
    }
  });
}

// History actions
function viewDetails(id) {
  const row = document.querySelector('#history-table-body tr[data-id="' + id + '"]');
  if (!row) return;
  const title = row.dataset.title || '-';
  const platform = row.dataset.platform || '-';
  const start = row.dataset.start || '';
  const stop = row.dataset.stop || '';
  const duration = row.dataset.duration || '';
  const thumb = row.dataset.thumbnail || '';

  document.getElementById('history-detail-title').textContent = title;
  document.getElementById('history-detail-platform').textContent = platform;
  document.getElementById('history-detail-start').textContent = start ? helpers.formatDateTime(start) : '-';
  document.getElementById('history-detail-stop').textContent = stop ? helpers.formatDateTime(stop) : '-';
  if (duration) {
    document.getElementById('history-detail-duration').textContent = helpers.formatDuration(duration);
  } else if (start && stop) {
    const d = Math.floor((new Date(stop) - new Date(start)) / 1000);
    document.getElementById('history-detail-duration').textContent = helpers.formatDuration(d);
  } else {
    document.getElementById('history-detail-duration').textContent = '-';
  }
  document.getElementById('history-detail-video').textContent = row.dataset.video || '-';
  const img = document.getElementById('history-detail-thumb');
  img.src = thumb || '/images/default-video-thumbnail.svg';

  const modal = document.getElementById('history-details-modal');
  if (modal) modal.classList.remove('hidden');
}

function closeHistoryDetails() {
  const modal = document.getElementById('history-details-modal');
  if (modal) modal.classList.add('hidden');
}

async function deleteHistory(id, title) {
  if (!confirm('Are you sure you want to delete history for "' + title + '"?')) return;

  try {
    const res = await fetch('/api/history/' + encodeURIComponent(id), {
      method: 'DELETE',
      headers: {
        'Content-Type': 'application/json',
        'x-csrf-token': __csrfToken
      }
    });

    if (!res.ok) {
      const body = await res.json().catch(() => ({}));
      showToast(body.error || 'Failed to delete history entry', 'error');
      return;
    }

    // Remove row from table
    const row = document.querySelector('#history-table-body tr[data-id="' + id + '"]');
    if (row) row.remove();

    showToast('History entry deleted', 'success');
  } catch (err) {
    console.error('Error deleting history:', err);
    showToast('Failed to delete history entry', 'error');
  }
}
</script>
