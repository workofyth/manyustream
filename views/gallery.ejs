<% layout('layout') -%>

<!-- Page Heading -->
<div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
  <div>
    <h2 class="text-title-md2 font-semibold text-black dark:text-white">
      Video Gallery
    </h2>
    <p class="text-sm text-bodydark mt-1">Manage your video library for streaming</p>
  </div>
  
  <div class="flex flex-wrap gap-3">
    <button onclick="openUploadModal()"
      class="inline-flex items-center justify-center gap-2 rounded-md bg-primary py-2.5 px-4 text-center font-medium text-white hover:bg-opacity-90">
      <i class="ti ti-upload"></i>
      <span>Upload Video</span>
    </button>
    <button onclick="openGDriveModal()"
      class="inline-flex items-center justify-center gap-2 rounded-md bg-meta-5 py-2.5 px-4 text-center font-medium text-white hover:bg-opacity-90">
      <i class="ti ti-brand-google-drive"></i>
      <span>Import from Drive</span>
    </button>
  </div>
</div>

<!-- Filters -->
<div class="mb-6 rounded-sm border border-stroke bg-white shadow-default dark:border-strokedark dark:bg-boxdark p-4">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
    <div class="relative flex-1 max-w-md">
      <input type="text" id="search-videos" placeholder="Search videos..."
        class="w-full rounded-lg border border-stroke bg-transparent py-2.5 pl-10 pr-4 text-black outline-none focus:border-primary focus-visible:shadow-none dark:border-strokedark dark:bg-meta-4 dark:text-white dark:focus:border-primary">
      <i class="ti ti-search absolute left-3 top-1/2 -translate-y-1/2 text-bodydark"></i>
    </div>
    
    <select id="sort-videos"
      class="rounded-lg border border-stroke bg-transparent py-2.5 px-4 text-black outline-none focus:border-primary dark:border-strokedark dark:bg-meta-4 dark:text-white">
      <option value="newest">Newest First</option>
      <option value="oldest">Oldest First</option>
      <option value="name">Name (A-Z)</option>
      <option value="size">File Size</option>
    </select>
  </div>
</div>

<!-- Video Grid -->
<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4" id="video-grid">
  <% if (videos && videos.length > 0) { %>
    <% videos.forEach(function(video) { %>
      <div class="rounded-sm border border-stroke bg-white shadow-default dark:border-strokedark dark:bg-boxdark overflow-hidden group">
        <!-- Video Thumbnail -->
        <div class="relative aspect-video overflow-hidden bg-gray-2 dark:bg-meta-4">
          <img src="<%= video.thumbnail_path %>" alt="<%= video.title %>" 
               class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
               onerror="this.src='/images/default-video-thumbnail.svg'">
          
          <!-- Play Button Overlay -->
          <div class="absolute inset-0 flex items-center justify-center bg-black bg-opacity-0 transition-all duration-300 group-hover:bg-opacity-40">
            <button onclick="playVideo('<%= video.id %>', '<%= video.title %>')"
              class="flex h-14 w-14 items-center justify-center rounded-full bg-primary text-white opacity-0 transition-all duration-300 hover:bg-opacity-90 group-hover:opacity-100">
              <i class="ti ti-player-play-filled text-2xl"></i>
            </button>
          </div>
          
          <!-- Duration Badge -->
          <span class="absolute bottom-2 right-2 rounded bg-black bg-opacity-70 px-2 py-0.5 text-xs text-white">
            <%= video.duration ? Math.floor(video.duration / 60) + ':' + String(Math.floor(video.duration % 60)).padStart(2, '0') : '0:00' %>
          </span>
        </div>
        
        <!-- Video Info -->
        <div class="p-4">
          <h5 class="mb-2 font-medium text-black dark:text-white line-clamp-2" title="<%= video.title %>">
            <%= video.title %>
          </h5>
          
          <div class="flex items-center justify-between text-xs text-bodydark">
            <div class="flex items-center gap-2">
              <span><%= new Date(video.upload_date).toLocaleDateString() %></span>
              <span>•</span>
              <span><%= (video.file_size / (1024 * 1024)).toFixed(1) %> MB</span>
            </div>
            
            <!-- Actions -->
            <div class="flex items-center gap-1">
              <button onclick="editVideo('<%= video.id %>', '<%= video.title %>')"
                class="rounded p-1.5 text-bodydark hover:bg-gray-2 hover:text-primary dark:hover:bg-meta-4">
                <i class="ti ti-pencil"></i>
              </button>
              <button onclick="deleteVideo('<%= video.id %>', '<%= video.title %>')"
                class="rounded p-1.5 text-bodydark hover:bg-gray-2 hover:text-danger dark:hover:bg-meta-4">
                <i class="ti ti-trash"></i>
              </button>
            </div>
          </div>
        </div>
      </div>
    <% }); %>
  <% } else { %>
    <!-- Empty State -->
    <div class="col-span-full rounded-sm border border-stroke bg-white shadow-default dark:border-strokedark dark:bg-boxdark p-12 text-center">
      <div class="flex flex-col items-center justify-center">
        <i class="ti ti-video-off text-6xl text-bodydark mb-4"></i>
        <h3 class="mb-2 text-xl font-semibold text-black dark:text-white">No Videos Yet</h3>
        <p class="mb-6 text-bodydark">Upload your first video to get started with streaming</p>
        <button onclick="openUploadModal()"
          class="inline-flex items-center justify-center gap-2 rounded-md bg-primary py-2.5 px-6 text-center font-medium text-white hover:bg-opacity-90">
          <i class="ti ti-upload"></i>
          <span>Upload Video</span>
        </button>
      </div>
    </div>
  <% } %>
</div>

<!-- Video Player Modal -->
<div id="videoPlayerModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black bg-opacity-75">
  <div class="relative w-full max-w-4xl mx-4">
    <button onclick="closeVideoPlayer()" class="absolute -top-12 right-0 text-white hover:text-primary">
      <i class="ti ti-x text-3xl"></i>
    </button>
    <video id="videoPlayer" class="w-full rounded-lg" controls>
      <source src="" type="video/mp4">
      Your browser does not support the video tag.
    </video>
  </div>
</div>

<!-- Upload Video Modal -->
<div id="uploadModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black bg-opacity-60">
  <div class="relative w-full max-w-2xl mx-4 bg-white dark:bg-boxdark rounded-lg shadow-xl">
    <div class="flex items-center justify-between p-6 border-b border-stroke dark:border-strokedark">
      <h3 class="text-lg font-semibold text-black dark:text-white">Upload Video</h3>
      <button onclick="closeUploadModal()" class="text-bodydark dark:text-bodydark1 hover:text-black dark:hover:text-white">
        <i class="ti ti-x text-2xl"></i>
      </button>
    </div>
    
    <div class="p-6">
      <form id="videoUploadForm" enctype="multipart/form-data">
        <!-- Drag & Drop Area -->
        <div id="uploadDropzone" class="border-2 border-dashed border-stroke dark:border-strokedark rounded-lg p-8 text-center cursor-pointer hover:border-primary transition-colors">
          <div class="flex flex-col items-center justify-center space-y-3">
            <i class="ti ti-upload text-5xl text-bodydark dark:text-bodydark1"></i>
            <div>
              <p class="text-black dark:text-white font-medium">Drag and drop video files here</p>
              <p class="text-bodydark dark:text-bodydark1 text-sm">Or click to browse</p>
            </div>
            <label class="inline-flex items-center justify-center gap-2 rounded-md bg-primary py-2.5 px-4 text-center font-medium text-white hover:bg-opacity-90 cursor-pointer">
              <i class="ti ti-upload"></i>
              <span>Select files</span>
              <input type="file" name="video" accept="video/mp4,video/avi,video/quicktime" multiple class="hidden" id="videoFileInput">
            </label>
            <p class="text-bodydark dark:text-bodydark1 text-xs">Supported: MP4, AVI, MOV (Max 2GB)</p>
          </div>
        </div>
        
        <!-- Selected Files -->
        <div id="selectedFileInfo" class="hidden mt-6">
          <div class="bg-bodydark2 dark:bg-meta-4 p-4 rounded-lg border border-stroke dark:border-strokedark">
            <div class="flex items-center justify-between mb-3">
              <p class="font-medium text-black dark:text-white">Selected Files</p>
              <button type="button" onclick="document.getElementById('videoFileInput').click()" class="text-primary hover:underline flex items-center gap-1 text-sm">
                <i class="ti ti-plus"></i> Add More
              </button>
            </div>
            <div id="selectedFilesList" class="space-y-2 max-h-48 overflow-y-auto">
            </div>
          </div>
        </div>
        
        <!-- Upload Progress -->
        <div id="uploadProgress" class="hidden mt-6">
          <div class="flex justify-between items-center text-sm mb-2">
            <span id="uploadProgressStatus" class="text-black dark:text-white">Uploading files...</span>
            <span id="uploadProgressPercent" class="text-primary font-medium">0%</span>
          </div>
          <div class="w-full bg-bodydark2 dark:bg-meta-4 rounded-full h-2.5 overflow-hidden">
            <div id="uploadProgressBar" class="bg-primary h-2.5 rounded-full transition-all duration-300" style="width: 0%"></div>
          </div>
        </div>
      </form>
    </div>
    
    <div class="flex justify-end gap-3 p-6 border-t border-stroke dark:border-strokedark">
      <button onclick="closeUploadModal()" class="px-4 py-2 rounded-md border border-stroke dark:border-strokedark text-bodydark dark:text-bodydark1 hover:bg-gray-2 dark:hover:bg-meta-4">
        Cancel
      </button>
      <button id="uploadButton" class="px-4 py-2 rounded-md bg-primary text-white hover:bg-opacity-90 disabled:opacity-50 disabled:cursor-not-allowed" disabled>
        <i class="ti ti-upload mr-2"></i>Upload
      </button>
    </div>
  </div>
</div>

<!-- Google Drive Import Modal -->
<div id="gDriveModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black bg-opacity-60">
  <div class="relative w-full max-w-2xl mx-4 bg-white dark:bg-boxdark rounded-lg shadow-xl">
    <div class="flex items-center justify-between p-6 border-b border-stroke dark:border-strokedark">
      <h3 class="text-lg font-semibold text-black dark:text-white">Import from Google Drive</h3>
      <button onclick="closeGDriveModal()" class="text-bodydark dark:text-bodydark1 hover:text-black dark:hover:text-white">
        <i class="ti ti-x text-2xl"></i>
      </button>
    </div>
    
    <div class="p-6">
      <div class="text-center py-8">
        <i class="ti ti-brand-google-drive text-6xl text-bodydark dark:text-bodydark1 mb-4"></i>
        <p class="text-black dark:text-white mb-2">Connect your Google Drive account</p>
        <p class="text-bodydark dark:text-bodydark1 text-sm mb-6">Authorize StreamFlow to access your videos from Google Drive</p>
        <button onclick="connectGoogleDrive()" class="inline-flex items-center justify-center gap-2 rounded-md bg-primary py-2.5 px-6 text-center font-medium text-white hover:bg-opacity-90">
          <i class="ti ti-brand-google"></i>
          <span>Connect Google Drive</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
// Video player functions
function playVideo(videoId, title) {
  const modal = document.getElementById('videoPlayerModal');
  const player = document.getElementById('videoPlayer');
  const source = player.querySelector('source');
  
  source.src = '/stream/' + videoId;
  source.type = 'video/mp4';
  
  player.load();
  
  modal.classList.remove('hidden');
  modal.classList.add('flex');
  player.play();
}

function closeVideoPlayer() {
  const modal = document.getElementById('videoPlayerModal');
  const player = document.getElementById('videoPlayer');
  const source = player.querySelector('source');
  
  player.pause();
  source.src = '';
  source.type = '';
  
  modal.classList.add('hidden');
  modal.classList.remove('flex');
}

// Upload Modal Functions
let selectedFiles = [];

function openUploadModal() {
  document.getElementById('uploadModal').classList.remove('hidden');
  document.getElementById('uploadModal').classList.add('flex');
  setupDragAndDrop();
}

function closeUploadModal() {
  document.getElementById('uploadModal').classList.add('hidden');
  document.getElementById('uploadModal').classList.remove('flex');
  selectedFiles = [];
  document.getElementById('selectedFilesList').innerHTML = '';
  document.getElementById('selectedFileInfo').classList.add('hidden');
  document.getElementById('uploadProgress').classList.add('hidden');
}

function setupDragAndDrop() {
  const dropzone = document.getElementById('uploadDropzone');
  
  dropzone.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add('border-primary', 'bg-gray-2', 'dark:bg-meta-4');
  });
  
  dropzone.addEventListener('dragleave', () => {
    dropzone.classList.remove('border-primary', 'bg-gray-2', 'dark:bg-meta-4');
  });
  
  dropzone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('border-primary', 'bg-gray-2', 'dark:bg-meta-4');
    handleFiles(Array.from(e.dataTransfer.files));
  });
  
  dropzone.addEventListener('click', () => {
    document.getElementById('videoFileInput').click();
  });
  
  document.getElementById('videoFileInput').addEventListener('change', (e) => {
    handleFiles(Array.from(e.target.files));
  });
}

function handleFiles(files) {
  selectedFiles = files.filter(f => f.type.startsWith('video/'));
  
  if (selectedFiles.length === 0) {
    alert('Please select valid video files');
    return;
  }
  
  displaySelectedFiles();
  document.getElementById('uploadButton').disabled = false;
}

function displaySelectedFiles() {
  const list = document.getElementById('selectedFilesList');
  list.innerHTML = '';
  
  selectedFiles.forEach((file, index) => {
    const fileSize = (file.size / (1024 * 1024)).toFixed(2);
    const div = document.createElement('div');
    div.className = 'flex items-center justify-between p-2 bg-white dark:bg-boxdark rounded border border-stroke dark:border-strokedark';
    div.innerHTML = `
      <div class="flex items-center gap-2">
        <i class="ti ti-file-video text-primary"></i>
        <div class="min-w-0">
          <p class="text-sm font-medium text-black dark:text-white truncate">${file.name}</p>
          <p class="text-xs text-bodydark dark:text-bodydark1">${fileSize} MB</p>
        </div>
      </div>
      <button type="button" onclick="removeFile(${index})" class="text-meta-1 hover:text-red-600">
        <i class="ti ti-x"></i>
      </button>
    `;
    list.appendChild(div);
  });
  
  document.getElementById('selectedFileInfo').classList.remove('hidden');
}

function removeFile(index) {
  selectedFiles.splice(index, 1);
  if (selectedFiles.length === 0) {
    document.getElementById('selectedFileInfo').classList.add('hidden');
    document.getElementById('uploadButton').disabled = true;
  } else {
    displaySelectedFiles();
  }
}

document.getElementById('uploadButton')?.addEventListener('click', () => {
  if (selectedFiles.length === 0) return;

  const formData = new FormData();
  selectedFiles.forEach(file => formData.append('video', file));

  const progressContainer = document.getElementById('uploadProgress');
  const progressBar = document.getElementById('uploadProgressBar');
  const progressPercent = document.getElementById('uploadProgressPercent');
  const progressStatus = document.getElementById('uploadProgressStatus');

  progressContainer.classList.remove('hidden');
  document.getElementById('uploadDropzone').style.display = 'none';
  document.getElementById('uploadButton').disabled = true;

  const xhr = new XMLHttpRequest();
  xhr.open('POST', '/api/videos/upload');

  xhr.upload.addEventListener('progress', (e) => {
    if (!e.lengthComputable) return;
    const percent = Math.round((e.loaded / e.total) * 100);
    if (progressBar) progressBar.style.width = percent + '%';
    if (progressPercent) progressPercent.textContent = percent + '%';
    if (progressStatus) progressStatus.textContent = `Uploading files... (${percent}%)`;
  });

  xhr.addEventListener('load', () => {
    if (xhr.status >= 200 && xhr.status < 300) {
      try {
        const res = JSON.parse(xhr.responseText);
        if (res && res.success) {
          progressBar.style.width = '100%';
          progressPercent.textContent = '100%';
          progressStatus.textContent = 'Upload complete';
          setTimeout(() => {
            closeUploadModal();
            window.location.reload();
          }, 600);
          return;
        }
      } catch (err) {
        // fallthrough to error handling
      }
      alert('Upload failed: ' + xhr.responseText);
    } else {
      alert('Upload failed with status ' + xhr.status + ': ' + xhr.statusText);
    }
    document.getElementById('uploadButton').disabled = false;
    if (progressStatus) progressStatus.textContent = 'Upload failed';
  });

  xhr.addEventListener('error', () => {
    alert('An error occurred during the upload.');
    document.getElementById('uploadButton').disabled = false;
    if (progressStatus) progressStatus.textContent = 'Upload error';
  });

  // Optional: set a timeout for large uploads (ms)
  xhr.timeout = 0; // no timeout by default
  xhr.addEventListener('timeout', () => {
    alert('Upload timed out');
    document.getElementById('uploadButton').disabled = false;
    if (progressStatus) progressStatus.textContent = 'Upload timed out';
  });

  // Send the form data
  xhr.send(formData);
});

// Google Drive Modal Functions
function openGDriveModal() {
  document.getElementById('gDriveModal').classList.remove('hidden');
  document.getElementById('gDriveModal').classList.add('flex');
}

function closeGDriveModal() {
  document.getElementById('gDriveModal').classList.add('hidden');
  document.getElementById('gDriveModal').classList.remove('flex');
}

function connectGoogleDrive() {
  // Redirect to Google OAuth flow
  window.location.href = '/auth/google';
}

// Video Edit/Delete
function editVideo(id, title) {
  console.log('Edit video:', id, title);
  // TODO: Implement edit modal
}

function deleteVideo(id, title) {
  if (confirm('Are you sure you want to delete "' + title + '"?')) {
    fetch('/api/videos/' + id, { method: 'DELETE' })
      .then(res => res.ok ? window.location.reload() : alert('Delete failed'))
      .catch(err => alert('Error: ' + err.message));
  }
}

// Search and filter
document.getElementById('search-videos')?.addEventListener('input', function(e) {
  const searchTerm = e.target.value.toLowerCase();
  const videos = document.querySelectorAll('#video-grid > div');
  videos.forEach(video => {
    const title = video.querySelector('h5')?.textContent.toLowerCase() || '';
    video.style.display = title.includes(searchTerm) ? '' : 'none';
  });
});

document.getElementById('sort-videos')?.addEventListener('change', function(e) {
  const sortBy = e.target.value;
  const container = document.getElementById('video-grid');
  const videos = Array.from(container.children);
  
  videos.sort((a, b) => {
    switch(sortBy) {
      case 'newest':
        return new Date(b.dataset.uploadDate || 0) - new Date(a.dataset.uploadDate || 0);
      case 'oldest':
        return new Date(a.dataset.uploadDate || 0) - new Date(b.dataset.uploadDate || 0);
      case 'name':
        const titleA = a.querySelector('h5')?.textContent || '';
        const titleB = b.querySelector('h5')?.textContent || '';
        return titleA.localeCompare(titleB);
      case 'size':
        const sizeA = parseFloat(a.querySelector('.text-bodydark')?.textContent) || 0;
        const sizeB = parseFloat(b.querySelector('.text-bodydark')?.textContent) || 0;
        return sizeB - sizeA;
      default:
        return 0;
    }
  });
  
  videos.forEach(video => container.appendChild(video));
});

// Close video player on Escape key
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    closeVideoPlayer();
    closeUploadModal();
    closeGDriveModal();
  }
});
</script>
